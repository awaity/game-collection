{
  "name": "shanhai-run",
  "version": "1.0.0",
  "displayName": "山海逃亡",
  "description": "青绿山川，异兽追逐。转弯、跳跃与滑铲，踏遍失落的山海古道。",
  "private": true,
  "type": "module",
  "uuid": "32ca267a-1fac-5f7d-91d4-f7921156f6ac",
  "creator": {
    "version": "3.8.8"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "node ../../packages/build-tools/src/cocos.mjs web",
    "build:weixin": "node ../../packages/build-tools/src/cocos.mjs weixin",
    "build:douyin": "node ../../packages/build-tools/src/cocos.mjs douyin",
    "build:mini": "pnpm build:weixin && pnpm build:douyin",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && tsx --test tests/*.test.ts",
    "verify:mini": "node ../../packages/build-tools/src/cocos-verify.mjs"
  },
  "devDependencies": {
    "@game-collection/build-tools": "workspace:*",
    "@game-collection/cocos-runtime": "workspace:*",
    "@game-collection/platform": "workspace:*",
    "typescript": "5.9.3",
    "tsx": "4.20.6"
  }
}
