{
  "name": "@game-collection/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.0.0 <12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awaity/game-collection.git"
  },
  "homepage": "https://awaity.github.io/game-collection/",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "pnpm dev:portal",
    "dev:portal": "pnpm --filter @game-collection/portal dev",
    "dev:volley-run": "pnpm --filter volley-run dev --host 0.0.0.0 --port 4273",
    "dev:zombie-lane": "pnpm --filter zombie-lane dev",
    "build": "node scripts/build-site.mjs",
    "test": "pnpm --filter volley-run test && pnpm --filter zombie-lane test && node --test tests/*.test.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:mini": "pnpm --filter zombie-lane build:weixin && pnpm --filter zombie-lane build:douyin && pnpm --filter zombie-lane verify:mini",
    "check": "pnpm build && pnpm test && pnpm verify:site && pnpm verify:mini",
    "preview": "node scripts/preview-site.mjs",
    "deploy": "pnpm check && node scripts/publish.mjs"
  },
  "devDependencies": {
    "gh-pages": "6.3.0"
  }
}
