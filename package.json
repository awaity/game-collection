    "predeploy": "npm run build && npm test",
    "deploy": "gh-pages -d dist/client --nojekyll -m \"chore(pages): 发布游戏合集静态站点\""
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "pngjs": "7.0.0",
    "vite": "6.4.2"
  },
